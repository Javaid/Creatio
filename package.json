    "node-cron": "^3.0.3",
    "sequelize": "^6.37.0",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nock": "^13.5.0",
