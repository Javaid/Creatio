# Copy to .env for local development. In production (IIS), set these as
# real environment variables instead of shipping a .env file.
# See docs/DEPLOYMENT.md §4 and docs/SECURITY.md §2.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
LOG_FORMAT=json

# --- Database (this service's own SQL Server database) ---
DB_HOST=localhost
DB_PORT=1433
DB_NAME=jira_sync_service
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=true

# --- Jira source system ---
# JIRA_AUTH_MODE: cloud-token | server-pat
JIRA_AUTH_MODE=cloud-token
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
# Comma-separated list of project keys to sync; leave blank for "all visible"
JIRA_PROJECT_KEYS=
JIRA_WEBHOOK_SHARED_SECRET=

# --- Sync scheduling (cron expressions) ---
SYNC_INCREMENTAL_CRON=*/10 * * * *
SYNC_FULL_CRON=0 3 * * *
SYNC_ERROR_RETRY_CRON=*/5 * * * *

# --- Changelog tracking ---
CHANGELOG_TRACKED_FIELDS=status,assignee,priority,sprint
